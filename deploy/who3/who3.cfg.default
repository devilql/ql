# who3 service configuration
# ---------------------------------------------------------------
# On first install this file is copied to /etc/who3/who3.cfg.
# Edit /etc/who3/who3.cfg on the server — do not edit this file
# for live configuration, as it will be overwritten on reinstall.
# ---------------------------------------------------------------

# OS user the service process runs as (created automatically if absent).
SERVICE_USER="who3"

# Directory where the binary is installed.
INSTALL_DIR="/opt/who3"

# Path to the SQLite database file.
# Must be inside INSTALL_DIR (or another path writable by SERVICE_USER).
DB_PATH="/opt/who3/who3.db"

# TCP address who3 listens on (e.g. ":8081" or "127.0.0.1:8081").
LISTEN_ADDR=":8081"

# Comma-separated list of exact CORS origins to allow.
# Example: "https://example.com,https://app.example.com"
CORS_ORIGINS=""

# Comma-separated list of domain suffixes whose subdomains are allowed.
# Example: "example.com,another.org"
CORS_ORIGIN_SUFFIXES=""
